+//! # Local games
+//!
+//! Everything about games that don't come from Steam: a library you add
+//! programs to (or import from a folder, itch.io or Minecraft), art and
+//! descriptions fetched from the internet, and LAN discovery.
+//!
+//! The modules `id`, `exe`, `text` and `lan` use only the standard library on
+//! purpose: they hold the logic that must be exactly right and are easy to
+//! test in isolation.
+
+pub mod exe;
+pub mod fetch;
+pub mod id;
+pub mod lan;
+pub mod library;
+pub mod scan;
+pub mod text;
+
+pub use library::{Art, LocalGame, Meta, Source, Store};
diff --git a/crates/localgames/src/library.rs b/crates/localgames/src/library.rs
new file mode 100644
index 0000000..c66919a
--- /dev/null
+++ b/crates/localgames/src/library.rs
@@ -0,0 +1,195 @@
+//! The saved list of local games.
+
+use crate::id;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Serialize, Deserialize)]
+pub enum Source {
+    /// Added by hand.
+    #[default]
+    Manual,
+    /// Found by scanning a games folder.
+    Folder,
+    Itch,
+    Minecraft,
+}
+
+/// Pictures for a game, as web addresses (the app's image cache keeps them on
+/// disk, so they still show offline once seen).
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Art {
+    /// Wide banner behind the game's page.
+    pub hero: Option<String>,
+    /// Tall box art for the library grid.
+    pub cover: Option<String>,
+    /// Small square icon.
+    pub icon: Option<String>,
+    /// Transparent title logo.
+    pub logo: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Meta {
+    pub description: String,
+    pub developers: Vec<String>,
+    pub publishers: Vec<String>,
+    pub release_date: String,
+    pub genres: Vec<String>,
+    /// Features like "Single-player", "Co-op", "Steam Achievements".
+    pub features: Vec<String>,
+    pub website: String,
+    /// The Steam game this was matched to, if any.
+    pub steam_app_id: Option<u32>,
+}
+
+impl Meta {
+    pub fn is_empty(&self) -> bool {
+        self.description.is_empty() && self.developers.is_empty() && self.genres.is_empty() && self.steam_app_id.is_none()
+    }
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct LocalGame {
+    pub name: String,
+    pub exe: String,
+    pub args: String,
+    pub source: Source,
+    pub art: Art,
+    pub meta: Meta,
+    pub notes: String,
+    /// A line shown to Steam friends while playing (rich presence).
+    pub status: String,
+    /// Seconds played with this launcher.
+    pub playtime_secs: u64,
+    /// Unix time of the last session's start.
+    pub last_played: Option<u64>,
+    pub added: u64,
+    /// Launch options to join a LAN host; `{ip}` and `{port}` are replaced.
+    pub join_args: String,
+    /// The game's own port when hosting a LAN game (0 = not set).
+    pub host_port: u16,
+    /// Hand-chosen art and info should survive a refresh.
+    pub art_locked: bool,
+}
+
+impl LocalGame {
+    pub fn new(name: impl Into<String>, exe: impl Into<String>, source: Source, now: u64) -> Self {
+        Self { name: name.into(), exe: exe.into(), source, added: now, ..Default::default() }
+    }
+
+    /// The id Steam uses for this game (see [`id::game_id`]).
+    pub fn game_id(&self) -> u64 {
+        id::game_id(&self.exe, &self.name)
+    }
+
+    pub fn same_program(&self, exe: &str) -> bool {
+        self.exe.eq_ignore_ascii_case(exe)
+    }
+}
+
+/// Everything saved: the games, plus the few settings that go with them.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Store {
+    pub games: Vec<LocalGame>,
+    /// SteamGridDB key (optional), for more art than the official store has.
+    pub sgdb_key: String,
+    /// Folder scanned for games.
+    pub games_folder: String,
+}
+
+impl Store {
+    /// A damaged or missing save is an empty library, never a crash.
+    pub fn from_json(s: &str) -> Self {
+        serde_json::from_str(s).unwrap_or_default()
+    }
+
+    pub fn to_json(&self) -> Option<String> {
+        serde_json::to_string(self).ok()
+    }
+
+    /// Add a game unless that program is already in the library. Returns its index.
+    pub fn add(&mut self, g: LocalGame) -> Result<usize, usize> {
+        if let Some(i) = self.games.iter().position(|x| x.same_program(&g.exe)) {
+            return Err(i);
+        }
+        self.games.push(g);
+        Ok(self.games.len() - 1)
+    }
+
+    /// Time played: add a finished session.
+    pub fn record_session(&mut self, index: usize, started: u64, secs: u64) {
+        if let Some(g) = self.games.get_mut(index) {
+            g.playtime_secs = g.playtime_secs.saturating_add(secs);
+            g.last_played = Some(started);
+        }
+    }
+
+    /// Most recently played first.
+    pub fn recent(&self) -> Vec<usize> {
+        let mut v: Vec<usize> = (0..self.games.len()).filter(|&i| self.games[i].last_played.is_some()).collect();
+        v.sort_by_key(|&i| std::cmp::Reverse(self.games[i].last_played));
+        v
+    }
+}
+
+/// "2h 15m", "40m", "less than a minute".
+pub fn format_playtime(secs: u64) -> String {
+    match secs {
+        0..=59 => "less than a minute".into(),
+        60..=3599 => format!("{}m", secs / 60),
+        _ => format!("{}h {}m", secs / 3600, secs % 3600 / 60),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_broken_save_is_an_empty_library() {
+        assert!(Store::from_json("{not json").games.is_empty());
+        assert!(Store::from_json("").games.is_empty());
+    }
+
+    #[test]
+    fn saves_round_trip_and_old_saves_without_new_fields_load() {
+        let mut s = Store::default();
+        s.add(LocalGame::new("Hades", r"C:\G\Hades.exe", Source::Manual, 5)).unwrap();
+        let back = Store::from_json(&s.to_json().unwrap());
+        assert_eq!(back.games, s.games);
+        let old = Store::from_json(r#"{"games":[{"name":"Old","exe":"o.exe"}]}"#);
+        assert_eq!(old.games[0].name, "Old");
+        assert_eq!(old.games[0].playtime_secs, 0);
+    }
+
+    #[test]
+    fn the_same_program_is_not_added_twice_whatever_its_case() {
+        let mut s = Store::default();
+        assert_eq!(s.add(LocalGame::new("A", r"C:\G\a.exe", Source::Manual, 0)), Ok(0));
+        assert_eq!(s.add(LocalGame::new("A again", r"c:\g\A.EXE", Source::Folder, 0)), Err(0));
+        assert_eq!(s.games.len(), 1);
+    }
+
+    #[test]
+    fn sessions_add_up_and_recent_is_ordered() {
+        let mut s = Store::default();
+        s.add(LocalGame::new("A", "a.exe", Source::Manual, 0)).unwrap();
+        s.add(LocalGame::new("B", "b.exe", Source::Manual, 0)).unwrap();
+        s.record_session(0, 100, 30);
+        s.record_session(0, 100, 40);
+        s.record_session(1, 200, 5);
+        assert_eq!(s.games[0].playtime_secs, 70);
+        assert_eq!(s.recent(), vec![1, 0]);
+    }
+
+    #[test]
+    fn playtime_reads_naturally() {
+        assert_eq!(format_playtime(5), "less than a minute");
+        assert_eq!(format_playtime(2400), "40m");
+        assert_eq!(format_playtime(8100), "2h 15m");
+    }
+}
diff --git a/crates/localgames/src/scan.rs b/crates/localgames/src/scan.rs
new file mode 100644
index 0000000..e9ca4e0
--- /dev/null
+++ b/crates/localgames/src/scan.rs
@@ -0,0 +1,149 @@
+//! Finding games already on this PC: a games folder, the itch.io app's
+//! library, and the Minecraft launcher.
+//!
+//! These only read folders and files; nothing is changed.
+
+use crate::exe::{find_exes, pick_main};
+use crate::library::Source;
+use crate::text::display_name;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+
+/// A game found on disk, not yet in the library.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Found {
+    pub name: String,
+    pub exe: PathBuf,
+    pub source: Source,
+    /// A cover picture the source itself knows (itch.io has one per game).
+    pub cover_url: Option<String>,
+}
+
+/// Each folder directly inside `root` is treated as one game.
+pub fn scan_folder(root: &Path) -> Vec<Found> {
+    let mut out = Vec::new();
+    let Ok(entries) = std::fs::read_dir(root) else { return out };
+    for entry in entries.flatten() {
+        if !entry.file_type().is_ok_and(|t| t.is_dir()) {
+            continue;
+        }
+        let folder = entry.file_name().to_string_lossy().to_string();
+        let exes = find_exes(&entry.path(), 3);
+        if let Some(main) = pick_main(&folder, &exes) {
+            out.push(Found { name: display_name(&folder), exe: main.path.clone(), source: Source::Folder, cover_url: None });
+        }
+    }
+    out.sort_by(|a, b| a.name.to_lowercase().cmp(&b.name.to_lowercase()));
+    out
+}
+
+/// Where the itch.io app keeps installed games, if it is installed.
+pub fn itch_apps_dir() -> Option<PathBuf> {
+    let dir = PathBuf::from(std::env::var_os("APPDATA")?).join("itch").join("apps");
+    dir.is_dir().then_some(dir)
+}
+
+/// What the itch.io app wrote about a game when it installed it
+/// (`.itch/receipt.json.gz`): its title and cover picture.
+fn itch_receipt(game_dir: &Path) -> Option<(String, Option<String>)> {
+    let file = std::fs::File::open(game_dir.join(".itch").join("receipt.json.gz")).ok()?;
+    let mut json = String::new();
+    // A receipt is a few kilobytes; cap what we read from a file we don't control.
+    flate2::read::GzDecoder::new(file).take(1 << 20).read_to_string(&mut json).ok()?;
+    let v: serde_json::Value = serde_json::from_str(&json).ok()?;
+    let game = v.get("game")?;
+    let title = game.get("title")?.as_str()?.trim().to_string();
+    let cover = game.get("coverUrl").and_then(|c| c.as_str()).filter(|c| c.starts_with("https://")).map(String::from);
+    (!title.is_empty()).then_some((title, cover))
+}
+
+/// Games installed with the itch.io app.
+pub fn scan_itch() -> Vec<Found> {
+    let Some(apps) = itch_apps_dir() else { return Vec::new() };
+    let mut out = Vec::new();
+    let Ok(entries) = std::fs::read_dir(&apps) else { return out };
+    for entry in entries.flatten() {
+        if !entry.file_type().is_ok_and(|t| t.is_dir()) {
+            continue;
+        }
+        let dir = entry.path();
+        let folder = entry.file_name().to_string_lossy().to_string();
+        let (name, cover_url) = itch_receipt(&dir).unwrap_or_else(|| (display_name(&folder), None));
+        let exes = find_exes(&dir, 3);
+        if let Some(main) = pick_main(&name, &exes).or_else(|| pick_main(&folder, &exes)) {
+            out.push(Found { name, exe: main.path.clone(), source: Source::Itch, cover_url });
+        }
+    }
+    out.sort_by(|a, b| a.name.to_lowercase().cmp(&b.name.to_lowercase()));
+    out
+}
+
+/// The Minecraft launcher, when installed in one of its usual places.
+pub fn scan_minecraft() -> Vec<Found> {
+    let mut candidates: Vec<PathBuf> = Vec::new();
+    for var in ["ProgramFiles(x86)", "ProgramFiles"] {
+        if let Some(base) = std::env::var_os(var) {
+            candidates.push(PathBuf::from(base).join("Minecraft Launcher").join("MinecraftLauncher.exe"));
+        }
+    }
+    if let Some(base) = std::env::var_os("LOCALAPPDATA") {
+        candidates.push(PathBuf::from(base).join("Programs").join("Minecraft Launcher").join("MinecraftLauncher.exe"));
+    }
+    candidates
+        .into_iter()
+        .find(|p| p.is_file())
+        .map(|exe| vec![Found { name: "Minecraft".into(), exe, source: Source::Minecraft, cover_url: None }])
+        .unwrap_or_default()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Write;
+
+    fn temp(name: &str) -> PathBuf {
+        let p = std::env::temp_dir().join(format!("sir-scan-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&p);
+        std::fs::create_dir_all(&p).unwrap();
+        p
+    }
+
+    #[test]
+    fn a_games_folder_yields_one_game_per_subfolder() {
+        let root = temp("folder");
+        std::fs::create_dir_all(root.join("Dead_Cells-v1.2")).unwrap();
+        std::fs::write(root.join("Dead_Cells-v1.2").join("deadcells.exe"), b"x").unwrap();
+        std::fs::write(root.join("Dead_Cells-v1.2").join("unins000.exe"), vec![0u8; 100]).unwrap();
+        std::fs::create_dir_all(root.join("Empty")).unwrap();
+        std::fs::write(root.join("loose.exe"), b"x").unwrap();
+        let found = scan_folder(&root);
+        assert_eq!(found.len(), 1);
+        assert_eq!(found[0].name, "Dead Cells");
+        assert!(found[0].exe.ends_with("deadcells.exe"));
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    #[test]
+    fn an_itch_receipt_gives_title_and_cover() {
+        let dir = temp("itch");
+        std::fs::create_dir_all(dir.join(".itch")).unwrap();
+        let json = br#"{"game":{"title":"Night in the Woods","coverUrl":"https://img.itch.zone/c.png"}}"#;
+        let mut gz = flate2::write::GzEncoder::new(Vec::new(), flate2::Compression::default());
+        gz.write_all(json).unwrap();
+        std::fs::write(dir.join(".itch").join("receipt.json.gz"), gz.finish().unwrap()).unwrap();
+        let (title, cover) = itch_receipt(&dir).unwrap();
+        assert_eq!(title, "Night in the Woods");
+        assert_eq!(cover.as_deref(), Some("https://img.itch.zone/c.png"));
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn a_missing_or_broken_receipt_is_just_none() {
+        let dir = temp("itch-bad");
+        assert!(itch_receipt(&dir).is_none());
+        std::fs::create_dir_all(dir.join(".itch")).unwrap();
+        std::fs::write(dir.join(".itch").join("receipt.json.gz"), b"not gzip").unwrap();
+        assert!(itch_receipt(&dir).is_none());
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}
diff --git a/crates/localgames/src/text.rs b/crates/localgames/src/text.rs
new file mode 100644
index 0000000..ad52cca
--- /dev/null
+++ b/crates/localgames/src/text.rs
@@ -0,0 +1,178 @@
+//! Small text helpers: matching a game's name against search results and
+//! cleaning descriptions fetched from the web.
+
+/// Lowercase letters and digits only, so "The Witness™" and "the witness"
+/// compare equal.
+pub fn normalize(s: &str) -> String {
+    s.chars().filter(|c| c.is_alphanumeric()).flat_map(|c| c.to_lowercase()).collect()
+}
+
+/// A folder name turned into a display name: separators become spaces and
+/// version or build tags are dropped ("My_Game-v1.2.3" -> "My Game").
+pub fn display_name(folder: &str) -> String {
+    let folder = cut_version(folder);
+    let spaced: String = folder.chars().map(|c| if matches!(c, '_' | '.') { ' ' } else { c }).collect();
+    let mut words: Vec<&str> = Vec::new();
+    for w in spaced.split_whitespace() {
+        let lower = w.to_ascii_lowercase();
+        let looks_like_version = lower.strip_prefix('v').is_some_and(|r| r.chars().next().is_some_and(|c| c.is_ascii_digit()));
+        let is_tag = matches!(lower.as_str(), "win64" | "win32" | "x64" | "x86" | "windows" | "portable" | "setup" | "build");
+        if looks_like_version || is_tag {
+            continue;
+        }
+        words.push(w.trim_matches('-'));
+    }
+    let name = words.into_iter().filter(|w| !w.is_empty()).collect::<Vec<_>>().join(" ");
+    if name.is_empty() { folder.trim().to_string() } else { name }
+}
+
+/// Everything before a "-v1.2"-style suffix ("My_Game-v1.2.3" -> "My_Game").
+fn cut_version(s: &str) -> &str {
+    let b = s.as_bytes();
+    for i in 0..b.len().saturating_sub(2) {
+        if matches!(b[i], b'-' | b'_' | b' ' | b'.') && matches!(b[i + 1], b'v' | b'V') && b[i + 2].is_ascii_digit() {
+            return &s[..i];
+        }
+    }
+    s
+}
+
+/// Which of `titles` is the game called `query`? Only a confident match is
+/// returned: an exact (normalized) match, else one title that contains the
+/// whole query or is contained by it. Anything unclear returns `None`, so
+/// the person picks instead of getting wrong art.
+pub fn best_match(query: &str, titles: &[&str]) -> Option<usize> {
+    let q = normalize(query);
+    if q.len() < 2 {
+        return None;
+    }
+    if let Some(i) = titles.iter().position(|t| normalize(t) == q) {
+        return Some(i);
+    }
+    let close: Vec<usize> = titles
+        .iter()
+        .enumerate()
+        .filter(|(_, t)| {
+            let t = normalize(t);
+            t.len() >= 3 && (t.starts_with(&q) || q.starts_with(&t))
+        })
+        .map(|(i, _)| i)
+        .collect();
+    // Only when exactly one result fits: two sequels both fit "Portal".
+    if close.len() == 1 { Some(close[0]) } else { None }
+}
+
+/// Split launch options into arguments: spaces separate them, double quotes
+/// keep spaces together (`--name "Two Words"` is two arguments).
+pub fn split_args(s: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut cur = String::new();
+    let mut quoted = false;
+    let mut started = false;
+    for c in s.chars() {
+        match c {
+            '"' => {
+                quoted = !quoted;
+                started = true;
+            }
+            c if c.is_whitespace() && !quoted => {
+                if started {
+                    out.push(std::mem::take(&mut cur));
+                    started = false;
+                }
+            }
+            c => {
+                cur.push(c);
+                started = true;
+            }
+        }
+    }
+    if started {
+        out.push(cur);
+    }
+    out
+}
+
+/// Plain text from the small bit of HTML store descriptions contain.
+pub fn strip_html(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    let mut tag: Option<String> = None;
+    for c in s.chars() {
+        match (&mut tag, c) {
+            (None, '<') => tag = Some(String::new()),
+            (Some(name), '>') => {
+                // Line-breaking tags separate words; inline ones (<b>) don't.
+                let n = name.trim_start_matches('/').to_ascii_lowercase();
+                if ["br", "p", "li", "div", "h1", "h2", "h3", "ul", "ol"].iter().any(|b| n == *b || n.starts_with(&format!("{b} ")) || n.starts_with(&format!("{b}/"))) {
+                    out.push(' ');
+                }
+                tag = None;
+            }
+            (Some(name), c) => name.push(c),
+            (None, c) => out.push(c),
+        }
+    }
+    let out = out
+        .replace("&quot;", "\"")
+        .replace("&#39;", "'")
+        .replace("&apos;", "'")
+        .replace("&lt;", "<")
+        .replace("&gt;", ">")
+        .replace("&nbsp;", " ")
+        .replace("&amp;", "&");
+    out.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn normalize_ignores_case_and_symbols() {
+        assert_eq!(normalize("The Witness™"), "thewitness");
+        assert_eq!(normalize("HADES"), normalize("hades"));
+    }
+
+    #[test]
+    fn display_name_drops_separators_and_versions() {
+        assert_eq!(display_name("My_Game-v1.2.3"), "My Game");
+        assert_eq!(display_name("Celeste_win64"), "Celeste");
+        assert_eq!(display_name("Dead.Cells"), "Dead Cells");
+        assert_eq!(display_name("v1"), "v1");
+    }
+
+    #[test]
+    fn exact_match_wins_even_with_sequels_listed() {
+        let titles = ["Portal 2", "Portal", "Portal Stories: Mel"];
+        assert_eq!(best_match("portal", &titles), Some(1));
+    }
+
+    #[test]
+    fn ambiguous_or_unrelated_results_are_not_guessed() {
+        assert_eq!(best_match("Portal", &["Portal 2", "Portal Stories: Mel"]), None);
+        assert_eq!(best_match("Hades", &["Minecraft"]), None);
+        assert_eq!(best_match("x", &["X"]), None);
+    }
+
+    #[test]
+    fn a_single_close_title_is_accepted() {
+        assert_eq!(best_match("Hades", &["Hades II", "Minecraft"]), Some(0));
+    }
+
+    #[test]
+    fn launch_options_split_like_a_command_line() {
+        assert_eq!(split_args("-windowed  -w 1280"), ["-windowed", "-w", "1280"]);
+        assert_eq!(split_args(r#"--name "Two Words" -x"#), ["--name", "Two Words", "-x"]);
+        assert_eq!(split_args(r#""" a"#), ["", "a"]);
+        assert!(split_args("   ").is_empty());
+        assert!(split_args("").is_empty());
+    }
+
+    #[test]
+    fn strip_html_removes_tags_and_decodes_entities() {
+        assert_eq!(strip_html("Fight &amp; <b>escape</b><br>the &quot;Underworld&quot;"), "Fight & escape the \"Underworld\"");
+        assert_eq!(strip_html("<p>One</p><p>Two</p>"), "One Two");
+        assert_eq!(strip_html("a <b>bold</b>."), "a bold.");
+        assert_eq!(strip_html("1 < 2"), "1");
+    }
+}
