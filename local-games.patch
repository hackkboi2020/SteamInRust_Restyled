diff --git a/crates/localgames/src/exe.rs b/crates/localgames/src/exe.rs
new file mode 100644
index 0000000..0e28940
--- /dev/null
+++ b/crates/localgames/src/exe.rs
@@ -0,0 +1,128 @@
+//! Finding a game's main program inside its folder.
+//!
+//! Game folders hold many `.exe` files: the game, an uninstaller, crash
+//! reporters, redistributable installers. [`pick_main`] guesses which one the
+//! person means to launch.
+
+use crate::text::normalize;
+use std::cmp::Reverse;
+use std::path::{Path, PathBuf};
+
+/// Programs that are never the game itself.
+const NOISE: &[&str] = &[
+    "unins", "uninstall", "setup", "install", "crash", "redist", "vcredist", "vc_redist", "dxsetup", "dotnet", "directx", "oalinst",
+    "helper", "notification", "updater", "webhelper", "cefprocess", "werfault", "unitycrash", "diagnostic", "eac_", "easyanticheat",
+];
+
+pub fn is_noise(file_name: &str) -> bool {
+    let l = file_name.to_ascii_lowercase();
+    NOISE.iter().any(|n| l.contains(n))
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Candidate {
+    pub path: PathBuf,
+    pub size: u64,
+}
+
+/// The most likely main program: one whose name matches the folder's wins,
+/// then the one closest to the top of the folder, then the biggest.
+pub fn pick_main<'a>(folder_name: &str, candidates: &'a [Candidate]) -> Option<&'a Candidate> {
+    let want = normalize(folder_name);
+    candidates
+        .iter()
+        .filter(|c| c.path.file_name().and_then(|n| n.to_str()).is_some_and(|n| !is_noise(n)))
+        .max_by_key(|c| {
+            let stem = c.path.file_stem().and_then(|s| s.to_str()).map(normalize).unwrap_or_default();
+            let name_match = stem.len() >= 3 && !want.is_empty() && (stem == want || want.contains(&stem) || stem.contains(&want));
+            (name_match, Reverse(c.path.components().count()), c.size)
+        })
+}
+
+/// Every `.exe` under `root`, up to `max_depth` folders down (0 = only
+/// `root`). Symlinks are not followed, and the result is capped.
+pub fn find_exes(root: &Path, max_depth: usize) -> Vec<Candidate> {
+    const CAP: usize = 500;
+    let mut out = Vec::new();
+    let mut stack = vec![(root.to_path_buf(), 0usize)];
+    while let Some((dir, depth)) = stack.pop() {
+        let Ok(entries) = std::fs::read_dir(&dir) else { continue };
+        for entry in entries.flatten() {
+            if out.len() >= CAP {
+                return out;
+            }
+            let Ok(kind) = entry.file_type() else { continue };
+            let path = entry.path();
+            if kind.is_dir() {
+                if depth < max_depth {
+                    stack.push((path, depth + 1));
+                }
+            } else if kind.is_file() && path.extension().is_some_and(|e| e.eq_ignore_ascii_case("exe")) {
+                let size = entry.metadata().map(|m| m.len()).unwrap_or(0);
+                out.push(Candidate { path, size });
+            }
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn c(p: &str, size: u64) -> Candidate {
+        Candidate { path: PathBuf::from(p), size }
+    }
+
+    #[test]
+    fn noise_is_recognised() {
+        assert!(is_noise("unins000.exe"));
+        assert!(is_noise("UnityCrashHandler64.exe"));
+        assert!(is_noise("vc_redist.x64.exe"));
+        assert!(!is_noise("Hades.exe"));
+    }
+
+    #[test]
+    fn a_program_named_like_the_folder_wins_over_a_bigger_one() {
+        let list = [c("G/Hades/Support.exe", 9_000), c("G/Hades/Hades.exe", 100)];
+        assert_eq!(pick_main("Hades", &list).unwrap().path, PathBuf::from("G/Hades/Hades.exe"));
+    }
+
+    #[test]
+    fn noise_never_wins_even_if_it_is_the_only_big_file() {
+        let list = [c("G/Game/unins000.exe", 90_000), c("G/Game/run.exe", 10)];
+        assert_eq!(pick_main("Something", &list).unwrap().path, PathBuf::from("G/Game/run.exe"));
+    }
+
+    #[test]
+    fn without_a_name_match_the_shallowest_then_biggest_is_chosen() {
+        let list = [c("G/Game/bin/deep.exe", 5_000), c("G/Game/top.exe", 10), c("G/Game/top2.exe", 20)];
+        assert_eq!(pick_main("Unrelated", &list).unwrap().path, PathBuf::from("G/Game/top2.exe"));
+    }
+
+    #[test]
+    fn only_noise_means_no_guess() {
+        assert!(pick_main("Game", &[c("G/Game/unins000.exe", 1)]).is_none());
+        assert!(pick_main("Game", &[]).is_none());
+    }
+
+    #[test]
+    fn find_exes_respects_depth_and_extension() {
+        let root = std::env::temp_dir().join(format!("sir-exe-test-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(root.join("a/b/c")).unwrap();
+        std::fs::write(root.join("top.EXE"), b"x").unwrap();
+        std::fs::write(root.join("a/readme.txt"), b"x").unwrap();
+        std::fs::write(root.join("a/b/mid.exe"), b"x").unwrap();
+        std::fs::write(root.join("a/b/c/deep.exe"), b"x").unwrap();
+        let names = |depth| {
+            let mut v: Vec<String> = find_exes(&root, depth).iter().map(|c| c.path.file_name().unwrap().to_string_lossy().to_string()).collect();
+            v.sort();
+            v
+        };
+        assert_eq!(names(0), ["top.EXE"]);
+        assert_eq!(names(2), ["mid.exe", "top.EXE"]);
+        assert_eq!(names(3), ["deep.exe", "mid.exe", "top.EXE"]);
+        let _ = std::fs::remove_dir_all(&root);
+    }
+}
diff --git a/crates/localgames/src/fetch.rs b/crates/localgames/src/fetch.rs
new file mode 100644
index 0000000..09f9582
--- /dev/null
+++ b/crates/localgames/src/fetch.rs
@@ -0,0 +1,373 @@
+//! Looking up a game on the internet: its description and details, and
+//! pictures to choose from.
+//!
+//! Two sources:
+//! - Steam's public store (no account or key): search, details, and the
+//!   official art every store page has.
+//! - SteamGridDB (needs a free API key the person adds in settings): lots of
+//!   community-made heroes, covers, icons and logos, and the only place most
+//!   indie or itch.io games have any.
+//!
+//! Nothing here is required to play: with no internet every call fails with
+//! an error and the library keeps what it has.
+
+use crate::library::{Art, Meta};
+use crate::text::strip_html;
+use serde_json::Value;
+use std::time::Duration;
+
+#[derive(Debug, thiserror::Error)]
+pub enum Error {
+    #[error("network: {0}")]
+    Http(#[from] reqwest::Error),
+    #[error("unexpected reply from {0}")]
+    Shape(&'static str),
+}
+
+pub type Result<T> = std::result::Result<T, Error>;
+
+const STEAM_CDN: &str = "https://cdn.akamai.steamstatic.com/steam/apps";
+const SGDB: &str = "https://www.steamgriddb.com/api/v2";
+
+/// A game that might be the one the person means.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Candidate {
+    pub title: String,
+    pub steam_app_id: Option<u32>,
+    pub sgdb_id: Option<u64>,
+    /// Small picture for the list.
+    pub thumb: Option<String>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ArtKind {
+    Hero,
+    Cover,
+    Icon,
+    Logo,
+}
+
+impl ArtKind {
+    pub const ALL: [ArtKind; 4] = [ArtKind::Hero, ArtKind::Cover, ArtKind::Icon, ArtKind::Logo];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            ArtKind::Hero => "Hero",
+            ArtKind::Cover => "Cover",
+            ArtKind::Icon => "Icon",
+            ArtKind::Logo => "Logo",
+        }
+    }
+
+    fn sgdb_path(self) -> &'static str {
+        match self {
+            ArtKind::Hero => "heroes",
+            ArtKind::Cover => "grids",
+            ArtKind::Icon => "icons",
+            ArtKind::Logo => "logos",
+        }
+    }
+}
+
+/// One picture the person can choose.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ArtOption {
+    pub url: String,
+    pub thumb: String,
+    pub source: &'static str,
+}
+
+#[derive(Clone)]
+pub struct Fetcher {
+    http: reqwest::Client,
+    sgdb_key: Option<String>,
+}
+
+impl Fetcher {
+    pub fn new(sgdb_key: &str) -> Result<Self> {
+        let http = reqwest::Client::builder()
+            .user_agent(concat!("SteamInRust/", env!("CARGO_PKG_VERSION")))
+            .timeout(Duration::from_secs(15))
+            .build()?;
+        let key = sgdb_key.trim();
+        Ok(Self { http, sgdb_key: (!key.is_empty()).then(|| key.to_string()) })
+    }
+
+    /// Games matching `query`, Steam's store first, then SteamGridDB's.
+    /// A source that fails is skipped; it is an error only if both do.
+    pub async fn search(&self, query: &str) -> Result<Vec<Candidate>> {
+        let steam = self.steam_search(query).await;
+        let grid = match &self.sgdb_key {
+            Some(_) => self.sgdb_search(query).await,
+            None => Ok(Vec::new()),
+        };
+        match (steam, grid) {
+            (Err(e), Err(_)) => Err(e),
+            (steam, grid) => {
+                let mut out = steam.unwrap_or_default();
+                for c in grid.unwrap_or_default() {
+                    if !out.iter().any(|o| crate::text::normalize(&o.title) == crate::text::normalize(&c.title)) {
+                        out.push(c);
+                    }
+                }
+                Ok(out)
+            }
+        }
+    }
+
+    async fn steam_search(&self, query: &str) -> Result<Vec<Candidate>> {
+        let v: Value = self
+            .http
+            .get("https://store.steampowered.com/api/storesearch/")
+            .query(&[("term", query), ("cc", "us"), ("l", "english")])
+            .send()
+            .await?
+            .error_for_status()?
+            .json()
+            .await?;
+        parse_steam_search(&v).ok_or(Error::Shape("Steam store search"))
+    }
+
+    async fn sgdb_search(&self, query: &str) -> Result<Vec<Candidate>> {
+        let v = self.sgdb_get(&format!("{SGDB}/search/autocomplete/{}", encode_path(query))).await?;
+        parse_sgdb_search(&v).ok_or(Error::Shape("SteamGridDB search"))
+    }
+
+    async fn sgdb_get(&self, url: &str) -> Result<Value> {
+        let key = self.sgdb_key.as_deref().unwrap_or_default();
+        Ok(self.http.get(url).bearer_auth(key).send().await?.error_for_status()?.json().await?)
+    }
+
+    /// Description, developer, genres and so on from Steam's store page.
+    pub async fn metadata(&self, steam_app_id: u32) -> Result<Meta> {
+        let v: Value = self
+            .http
+            .get("https://store.steampowered.com/api/appdetails")
+            .query(&[("appids", steam_app_id.to_string()), ("l", "english".into())])
+            .send()
+            .await?
+            .error_for_status()?
+            .json()
+            .await?;
+        parse_app_details(&v, steam_app_id).ok_or(Error::Shape("Steam app details"))
+    }
+
+    /// Does this address answer? Steam moved some games' art to new
+    /// addresses, so an official picture is only offered if it is really there.
+    async fn reachable(&self, url: &str) -> bool {
+        self.http.head(url).send().await.is_ok_and(|r| r.status().is_success())
+    }
+
+    /// Everything useful about a chosen game in one go: its details and the
+    /// first picture of each kind.
+    pub async fn fill(&self, c: &Candidate) -> (Option<Meta>, Art) {
+        let mut c = c.clone();
+        if c.sgdb_id.is_none() {
+            c.sgdb_id = self.sgdb_for(&c.title).await;
+        }
+        let meta = match c.steam_app_id {
+            Some(id) => self.metadata(id).await.ok(),
+            None => None,
+        };
+        let mut art = Art::default();
+        for kind in ArtKind::ALL {
+            let first = self.art_options(&c, kind).await.into_iter().next().map(|o| o.url);
+            match kind {
+                ArtKind::Hero => art.hero = first,
+                ArtKind::Cover => art.cover = first,
+                ArtKind::Icon => art.icon = first,
+                ArtKind::Logo => art.logo = first,
+            }
+        }
+        (meta, art)
+    }
+
+    /// Pictures of one kind for a game, official ones first.
+    pub async fn art_options(&self, c: &Candidate, kind: ArtKind) -> Vec<ArtOption> {
+        let mut out = Vec::new();
+        if let Some(official) = c.steam_app_id.and_then(|id| steam_art(id, kind)) {
+            if self.reachable(&official.url).await {
+                out.push(official);
+            }
+        }
+        if let (Some(_), Some(gid)) = (&self.sgdb_key, c.sgdb_id) {
+            if let Ok(v) = self.sgdb_get(&format!("{SGDB}/{}/game/{gid}", kind.sgdb_path())).await {
+                out.extend(parse_sgdb_art(&v));
+            }
+        }
+        out
+    }
+
+    /// SteamGridDB's own id for a game we only know from Steam (so its art
+    /// can be offered too). `None` without a key or when not found.
+    pub async fn sgdb_for(&self, title: &str) -> Option<u64> {
+        self.sgdb_key.as_ref()?;
+        self.sgdb_search(title).await.ok()?.into_iter().find(|c| crate::text::normalize(&c.title) == crate::text::normalize(title))?.sgdb_id
+    }
+}
+
+/// The official pictures every Steam store page has.
+pub fn steam_art(app_id: u32, kind: ArtKind) -> Option<ArtOption> {
+    let file = match kind {
+        ArtKind::Hero => "library_hero.jpg",
+        ArtKind::Cover => "library_600x900.jpg",
+        ArtKind::Logo => "logo.png",
+        // The store has no square icon; the header is the closest official one.
+        ArtKind::Icon => return None,
+    };
+    let url = format!("{STEAM_CDN}/{app_id}/{file}");
+    Some(ArtOption { thumb: url.clone(), url, source: "Steam" })
+}
+
+/// Percent-encode a path segment (a game title in a URL).
+fn encode_path(s: &str) -> String {
+    let mut out = String::new();
+    for b in s.bytes() {
+        if b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.' | b'~') {
+            out.push(b as char);
+        } else {
+            out.push_str(&format!("%{b:02X}"));
+        }
+    }
+    out
+}
+
+fn parse_steam_search(v: &Value) -> Option<Vec<Candidate>> {
+    let items = v.get("items")?.as_array()?;
+    Some(
+        items
+            .iter()
+            .filter(|i| i.get("type").and_then(Value::as_str).is_none_or(|t| t == "app"))
+            .filter_map(|i| {
+                let id = u32::try_from(i.get("id")?.as_u64()?).ok()?;
+                Some(Candidate {
+                    title: i.get("name")?.as_str()?.to_string(),
+                    steam_app_id: Some(id),
+                    sgdb_id: None,
+                    thumb: i.get("tiny_image").and_then(Value::as_str).map(String::from),
+                })
+            })
+            .take(10)
+            .collect(),
+    )
+}
+
+fn parse_sgdb_search(v: &Value) -> Option<Vec<Candidate>> {
+    if v.get("success")?.as_bool()? != true {
+        return None;
+    }
+    Some(
+        v.get("data")?
+            .as_array()?
+            .iter()
+            .filter_map(|g| Some(Candidate { title: g.get("name")?.as_str()?.to_string(), steam_app_id: None, sgdb_id: g.get("id")?.as_u64(), thumb: None }))
+            .take(10)
+            .collect(),
+    )
+}
+
+fn parse_sgdb_art(v: &Value) -> Vec<ArtOption> {
+    v.get("data")
+        .and_then(Value::as_array)
+        .map(|list| {
+            list.iter()
+                .filter_map(|a| {
+                    let url = a.get("url")?.as_str()?;
+                    let thumb = a.get("thumb").and_then(Value::as_str).unwrap_or(url);
+                    // https only: never fetch pictures over plain http.
+                    (url.starts_with("https://")).then(|| ArtOption { url: url.to_string(), thumb: thumb.to_string(), source: "SteamGridDB" })
+                })
+                .take(24)
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+fn parse_app_details(v: &Value, app_id: u32) -> Option<Meta> {
+    let entry = v.get(app_id.to_string())?;
+    if entry.get("success")?.as_bool()? != true {
+        return None;
+    }
+    let d = entry.get("data")?;
+    let strings = |key: &str| -> Vec<String> { d.get(key).and_then(Value::as_array).map(|a| a.iter().filter_map(|s| s.as_str().map(String::from)).collect()).unwrap_or_default() };
+    let described = |key: &str| -> Vec<String> {
+        d.get(key).and_then(Value::as_array).map(|a| a.iter().filter_map(|g| g.get("description")?.as_str().map(String::from)).collect()).unwrap_or_default()
+    };
+    Some(Meta {
+        description: strip_html(d.get("short_description").and_then(Value::as_str).unwrap_or_default()),
+        developers: strings("developers"),
+        publishers: strings("publishers"),
+        release_date: d.get("release_date").and_then(|r| r.get("date")).and_then(Value::as_str).unwrap_or_default().to_string(),
+        genres: described("genres"),
+        features: described("categories"),
+        website: d.get("website").and_then(Value::as_str).filter(|w| w.starts_with("https://") || w.starts_with("http://")).unwrap_or_default().to_string(),
+        steam_app_id: Some(app_id),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn steam_search_results_are_read() {
+        let v = json!({"total": 2, "items": [
+            {"type": "app", "name": "Hades", "id": 1145360, "tiny_image": "https://x/t.jpg"},
+            {"type": "sub", "name": "Hades Bundle", "id": 5}
+        ]});
+        let found = parse_steam_search(&v).unwrap();
+        assert_eq!(found.len(), 1);
+        assert_eq!(found[0].title, "Hades");
+        assert_eq!(found[0].steam_app_id, Some(1145360));
+        assert!(parse_steam_search(&json!({"nope": 1})).is_none());
+    }
+
+    #[test]
+    fn app_details_are_read_and_cleaned() {
+        let v = json!({"1145360": {"success": true, "data": {
+            "short_description": "Defy the god of the dead &amp; <b>escape</b>.",
+            "developers": ["Supergiant Games"], "publishers": ["Supergiant Games"],
+            "release_date": {"coming_soon": false, "date": "17 Sep, 2020"},
+            "genres": [{"id": "1", "description": "Action"}],
+            "categories": [{"id": 2, "description": "Single-player"}],
+            "website": "https://www.supergiantgames.com/"
+        }}});
+        let m = parse_app_details(&v, 1145360).unwrap();
+        assert_eq!(m.description, "Defy the god of the dead & escape.");
+        assert_eq!(m.developers, ["Supergiant Games"]);
+        assert_eq!(m.genres, ["Action"]);
+        assert_eq!(m.features, ["Single-player"]);
+        assert_eq!(m.steam_app_id, Some(1145360));
+    }
+
+    #[test]
+    fn a_failed_details_reply_is_not_data() {
+        assert!(parse_app_details(&json!({"9": {"success": false}}), 9).is_none());
+        assert!(parse_app_details(&json!({}), 9).is_none());
+    }
+
+    #[test]
+    fn sgdb_art_keeps_only_https_pictures() {
+        let v = json!({"success": true, "data": [
+            {"id": 1, "url": "https://cdn2.steamgriddb.com/a.png", "thumb": "https://cdn2.steamgriddb.com/t.png"},
+            {"id": 2, "url": "http://insecure/a.png"},
+            {"id": 3}
+        ]});
+        let art = parse_sgdb_art(&v);
+        assert_eq!(art.len(), 1);
+        assert_eq!(art[0].source, "SteamGridDB");
+    }
+
+    #[test]
+    fn titles_are_encoded_for_the_url_path() {
+        assert_eq!(encode_path("Dead Cells"), "Dead%20Cells");
+        assert_eq!(encode_path("a/b?c"), "a%2Fb%3Fc");
+    }
+
+    #[test]
+    fn official_steam_art_has_no_icon() {
+        assert!(steam_art(10, ArtKind::Icon).is_none());
+        assert!(steam_art(10, ArtKind::Hero).unwrap().url.ends_with("/10/library_hero.jpg"));
+    }
+}
diff --git a/crates/localgames/src/id.rs b/crates/localgames/src/id.rs
new file mode 100644
index 0000000..ba1a183
--- /dev/null
+++ b/crates/localgames/src/id.rs
@@ -0,0 +1,54 @@
+//! The id Steam gives a non-Steam game, so friends see the same game whether
+//! it was added here or as a shortcut in Steam.
+//!
+//! Steam builds it from a CRC-32 of the quoted program path followed by the
+//! display name, with the top bit set; the full 64-bit game id has that value
+//! in its high half and `0x02000000` (the "shortcut" type) in the low half.
+
+/// CRC-32 (IEEE 802.3, the one zlib and Steam use).
+pub fn crc32(data: &[u8]) -> u32 {
+    let mut crc = !0u32;
+    for &b in data {
+        crc ^= b as u32;
+        for _ in 0..8 {
+            let mask = (crc & 1).wrapping_neg();
+            crc = (crc >> 1) ^ (0xEDB8_8320 & mask);
+        }
+    }
+    !crc
+}
+
+/// The 32-bit "app id" of a shortcut.
+pub fn shortcut_app_id(exe: &str, name: &str) -> u32 {
+    crc32(format!("\"{exe}\"{name}").as_bytes()) | 0x8000_0000
+}
+
+/// The 64-bit game id sent to Steam when this game is running.
+pub fn game_id(exe: &str, name: &str) -> u64 {
+    ((shortcut_app_id(exe, name) as u64) << 32) | 0x0200_0000
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn crc32_matches_the_standard_check_value() {
+        assert_eq!(crc32(b"123456789"), 0xCBF4_3926);
+        assert_eq!(crc32(b""), 0);
+    }
+
+    #[test]
+    fn shortcut_ids_have_the_shortcut_shape() {
+        let id = game_id(r"C:\Games\Hades\Hades.exe", "Hades");
+        assert_eq!(id & 0xFFFF_FFFF, 0x0200_0000);
+        assert!(id >> 63 == 1, "top bit must be set");
+        assert_eq!(shortcut_app_id("a", "b") >> 31, 1);
+    }
+
+    #[test]
+    fn same_input_same_id_different_input_different_id() {
+        assert_eq!(game_id("x.exe", "X"), game_id("x.exe", "X"));
+        assert_ne!(game_id("x.exe", "X"), game_id("x.exe", "Y"));
+    }
+}
diff --git a/crates/localgames/src/lan.rs b/crates/localgames/src/lan.rs
new file mode 100644
index 0000000..7504df9
--- /dev/null
+++ b/crates/localgames/src/lan.rs
@@ -0,0 +1,218 @@
+//! LAN discovery: find who on the same network is hosting a game.
+//!
+//! Hosts broadcast a small announcement over UDP every few seconds; everyone
+//! listens and keeps a list of hosts seen recently. This only finds people.
+//! The game's own networking does the actual playing, so joining means
+//! starting the game with the host's address filled into the launch options
+//! (see [`fill_template`]).
+//!
+//! Everything received is untrusted input from the network: packets are size
+//! limited, text is stripped of control characters and truncated, and the
+//! table of known hosts has a fixed maximum size.
+
+use std::collections::HashMap;
+use std::io;
+use std::net::{IpAddr, UdpSocket};
+use std::time::{Duration, Instant};
+
+pub const PORT: u16 = 47620;
+const MAGIC: &str = "SIRLAN1";
+const MAX_PACKET: usize = 512;
+const MAX_TEXT: usize = 48;
+const MAX_HOSTS: usize = 256;
+
+/// How long a host stays listed without a new announcement.
+pub const TTL: Duration = Duration::from_secs(10);
+/// How often a host should announce itself.
+pub const INTERVAL: Duration = Duration::from_secs(3);
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Announce {
+    /// Random per run, so our own broadcasts can be ignored.
+    pub instance: u64,
+    /// Who is hosting.
+    pub nick: String,
+    /// The game being hosted.
+    pub game: String,
+    /// The game's own port, for joining.
+    pub port: u16,
+    pub players: u8,
+    pub max_players: u8,
+}
+
+/// No control characters (tabs and newlines would break the format), at most
+/// [`MAX_TEXT`] characters, no surrounding spaces.
+fn clean(s: &str) -> String {
+    s.chars().filter(|c| !c.is_control()).take(MAX_TEXT).collect::<String>().trim().to_string()
+}
+
+pub fn encode(a: &Announce) -> String {
+    format!("{MAGIC}\t{:x}\t{}\t{}\t{}\t{}\t{}", a.instance, clean(&a.nick), clean(&a.game), a.port, a.players, a.max_players)
+}
+
+/// `None` for anything that isn't a well-formed announcement.
+pub fn decode(text: &str) -> Option<Announce> {
+    let mut parts = text.split('\t');
+    if parts.next()? != MAGIC {
+        return None;
+    }
+    let instance = u64::from_str_radix(parts.next()?, 16).ok()?;
+    let nick = clean(parts.next()?);
+    let game = clean(parts.next()?);
+    let port: u16 = parts.next()?.parse().ok()?;
+    let players: u8 = parts.next()?.parse().ok()?;
+    let max_players: u8 = parts.next()?.parse().ok()?;
+    if parts.next().is_some() || port == 0 || game.is_empty() {
+        return None;
+    }
+    Some(Announce { instance, nick, game, port, players, max_players })
+}
+
+#[derive(Debug, Clone)]
+pub struct Host {
+    pub ip: IpAddr,
+    pub announce: Announce,
+    pub seen: Instant,
+}
+
+/// Hosts heard recently.
+#[derive(Default)]
+pub struct Peers {
+    hosts: HashMap<(IpAddr, u64), Host>,
+}
+
+impl Peers {
+    pub fn update(&mut self, ip: IpAddr, announce: Announce, now: Instant) {
+        let key = (ip, announce.instance);
+        if !self.hosts.contains_key(&key) && self.hosts.len() >= MAX_HOSTS {
+            self.prune(now);
+            if self.hosts.len() >= MAX_HOSTS {
+                return; // a flood of fake hosts must not grow memory
+            }
+        }
+        self.hosts.insert(key, Host { ip, announce, seen: now });
+    }
+
+    pub fn prune(&mut self, now: Instant) {
+        self.hosts.retain(|_, h| now.saturating_duration_since(h.seen) <= TTL);
+    }
+
+    /// Hosts still fresh, sorted by game then host name.
+    pub fn live(&self, now: Instant) -> Vec<&Host> {
+        let mut v: Vec<&Host> = self.hosts.values().filter(|h| now.saturating_duration_since(h.seen) <= TTL).collect();
+        v.sort_by(|a, b| (&a.announce.game, &a.announce.nick, a.ip).cmp(&(&b.announce.game, &b.announce.nick, b.ip)));
+        v
+    }
+}
+
+/// Launch options for joining: `{ip}` and `{port}` are replaced. Only these
+/// two values (an address parsed from the packet's source and a number) are
+/// ever inserted; text from the network is never put on a command line.
+pub fn fill_template(template: &str, ip: IpAddr, port: u16) -> String {
+    template.replace("{ip}", &ip.to_string()).replace("{port}", &port.to_string())
+}
+
+/// A UDP socket that sends and receives announcements.
+pub struct Beacon {
+    sock: UdpSocket,
+}
+
+impl Beacon {
+    pub fn bind() -> io::Result<Self> {
+        let sock = UdpSocket::bind(("0.0.0.0", PORT))?;
+        sock.set_broadcast(true)?;
+        sock.set_nonblocking(true)?;
+        Ok(Self { sock })
+    }
+
+    pub fn announce(&self, a: &Announce) -> io::Result<()> {
+        self.sock.send_to(encode(a).as_bytes(), ("255.255.255.255", PORT)).map(|_| ())
+    }
+
+    /// Read everything waiting, add valid announcements from others to
+    /// `peers`. Never blocks.
+    pub fn poll(&self, own_instance: u64, peers: &mut Peers, now: Instant) {
+        let mut buf = [0u8; MAX_PACKET];
+        loop {
+            match self.sock.recv_from(&mut buf) {
+                // A full buffer may have been cut off: don't trust it.
+                Ok((n, _)) if n >= MAX_PACKET => continue,
+                Ok((n, from)) => {
+                    if let Some(a) = std::str::from_utf8(&buf[..n]).ok().and_then(decode) {
+                        if a.instance != own_instance {
+                            peers.update(from.ip(), a, now);
+                        }
+                    }
+                }
+                Err(_) => break, // WouldBlock: nothing more waiting
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::net::Ipv4Addr;
+
+    fn sample() -> Announce {
+        Announce { instance: 0xABCD, nick: "Sam".into(), game: "Minecraft".into(), port: 25565, players: 2, max_players: 8 }
+    }
+
+    #[test]
+    fn encode_then_decode_round_trips() {
+        assert_eq!(decode(&encode(&sample())), Some(sample()));
+    }
+
+    #[test]
+    fn tabs_and_newlines_cannot_break_the_format() {
+        let mut a = sample();
+        a.nick = "evil\tname\nhere".into();
+        let back = decode(&encode(&a)).expect("still valid");
+        assert_eq!(back.nick, "evilnamehere");
+        assert_eq!(back.game, "Minecraft");
+    }
+
+    #[test]
+    fn long_text_is_truncated() {
+        let mut a = sample();
+        a.game = "x".repeat(500);
+        assert_eq!(decode(&encode(&a)).unwrap().game.chars().count(), MAX_TEXT);
+    }
+
+    #[test]
+    fn junk_is_rejected() {
+        for bad in ["", "hello", "SIRLAN1", "SIRLAN2\t1\ta\tb\t1\t1\t1", "SIRLAN1\tzz\ta\tb\t1\t1\t1", "SIRLAN1\t1\ta\tb\t0\t1\t1", "SIRLAN1\t1\ta\t\t1\t1\t1", "SIRLAN1\t1\ta\tb\t99999\t1\t1", "SIRLAN1\t1\ta\tb\t1\t1\t1\textra"] {
+            assert_eq!(decode(bad), None, "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn hosts_expire_and_are_sorted() {
+        let t0 = Instant::now();
+        let ip = |n| IpAddr::V4(Ipv4Addr::new(192, 168, 0, n));
+        let mut peers = Peers::default();
+        peers.update(ip(5), Announce { game: "Zed".into(), ..sample() }, t0);
+        peers.update(ip(6), Announce { instance: 2, game: "Alpha".into(), ..sample() }, t0);
+        let games: Vec<_> = peers.live(t0).iter().map(|h| h.announce.game.clone()).collect();
+        assert_eq!(games, ["Alpha", "Zed"]);
+        assert!(peers.live(t0 + TTL + Duration::from_secs(1)).is_empty());
+    }
+
+    #[test]
+    fn the_host_table_cannot_be_flooded() {
+        let t0 = Instant::now();
+        let mut peers = Peers::default();
+        for i in 0..(MAX_HOSTS as u64 + 100) {
+            peers.update(IpAddr::V4(Ipv4Addr::new(10, 0, 0, 1)), Announce { instance: i, ..sample() }, t0);
+        }
+        assert_eq!(peers.live(t0).len(), MAX_HOSTS);
+    }
+
+    #[test]
+    fn the_join_template_only_inserts_address_and_port() {
+        let ip = IpAddr::V4(Ipv4Addr::new(192, 168, 1, 20));
+        assert_eq!(fill_template("--connect {ip}:{port}", ip, 25565), "--connect 192.168.1.20:25565");
+        assert_eq!(fill_template("-nojoin", ip, 1), "-nojoin");
+    }
+}
